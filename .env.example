# My Pasture local Docker environment
# Copy this file to .env for everyday local Docker Compose runs.

# Spring profile
SPRING_PROFILES_ACTIVE=docker

# PostgreSQL(pgvector)
POSTGRES_DB=mypasture
POSTGRES_USER=mypasture
POSTGRES_PASSWORD=mypasture
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend / Nginx
BACKEND_PORT=8080
NGINX_PORT=80

# Bible data
KOR1910_HTML_PATH=/app/data/kor_html

# AI
# Put the real key only in .env, never commit it.
OPENAI_API_KEY=test
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
AI_MAX_INPUT_CHARS=300
AI_MAX_OUTPUT_TOKENS=700
AI_FREE_DAILY_LIMIT=10
AI_TIMEOUT_MS=12000
AI_CACHE_TTL_SECONDS=86400
AI_COMMENTARY_GENERATION_ENABLED=false
AI_COMMENTARY_POLL_DELAY_MS=5000
AI_COMMENTARY_PROMPT_VERSION=chapter-commentary-v1
AI_COMMENTARY_MAX_OUTPUT_TOKENS=1800
AI_COMMENTARY_INPUT_COST_PER_MILLION=0.25
AI_COMMENTARY_OUTPUT_COST_PER_MILLION=2.00

# JWT
JWT_ISSUER=mypasture-docker
JWT_SECRET=local-docker-jwt-secret-change-me-32-bytes-min
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# Password reset (local Docker logs the link instead of sending email)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_URL=mypasture://password-reset
PASSWORD_RESET_DELIVERY=log
PASSWORD_RESET_FROM=no-reply@mypasture.app

# Quiet time invite URL (frontend renders this value as QR)
QUIET_TIME_DEFAULT_MEETING_DURATION_MINUTES=120
QUIET_TIME_QR_EXPIRY_GRACE_MINUTES=30
QUIET_TIME_INVITE_BASE_URL=https://mypasture.app/q/qt

# Social login
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
