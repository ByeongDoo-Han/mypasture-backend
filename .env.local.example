# My Pasture server local environment
# Copy to .env.local. Spring imports this file when the local profile is active.
SPRING_PROFILES_ACTIVE=local

# Direct JVM execution uses H2. Docker Compose overrides these with PostgreSQL.
DATABASE_URL=jdbc:h2:mem:mypasture;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver
JPA_DDL_AUTO=create-drop
FLYWAY_ENABLED=false

# Docker Compose PostgreSQL
POSTGRES_DB=mypasture
POSTGRES_USER=mypasture
POSTGRES_PASSWORD=mypasture
POSTGRES_PORT=5432
BACKEND_PORT=8080
NGINX_PORT=80

REDIS_HOST=localhost
REDIS_PORT=6379
KOR1910_HTML_PATH=data/kor_html

OPENAI_API_KEY=test
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MOCK_ENABLED=true
AI_MAX_INPUT_CHARS=300
AI_MAX_OUTPUT_TOKENS=700
AI_FREE_DAILY_LIMIT=10
AI_TIMEOUT_MS=12000
AI_CACHE_TTL_SECONDS=86400

JWT_ISSUER=mypasture-local
JWT_SECRET=local-jwt-secret-change-me-32-bytes-minimum
JWT_ACCESS_TOKEN_TTL_SECONDS=3600

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_URL=mypasture://password-reset
PASSWORD_RESET_DELIVERY=log
PASSWORD_RESET_FROM=no-reply@mypasture.app

QUIET_TIME_DEFAULT_MEETING_DURATION_MINUTES=120
QUIET_TIME_QR_EXPIRY_GRACE_MINUTES=30
QUIET_TIME_INVITE_BASE_URL=https://mypasture.app/q/qt

# Comma-separated public OAuth client identifiers. Never put client secrets here.
GOOGLE_OAUTH_WEB_CLIENT_IDS=
GOOGLE_OAUTH_IOS_CLIENT_IDS=
GOOGLE_OAUTH_ANDROID_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
