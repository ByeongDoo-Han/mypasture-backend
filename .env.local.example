# My Pasture server local environment
# Copy to .env.local. Spring imports this file when the local profile is active.
SPRING_PROFILES_ACTIVE=local

# Direct JVM execution uses H2. Docker Compose overrides these with PostgreSQL.
DATABASE_URL=jdbc:h2:mem:mypasture;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver
JPA_DDL_AUTO=create-drop
FLYWAY_ENABLED=false

# Docker Compose PostgreSQL
POSTGRES_DB=mypasture
POSTGRES_USER=mypasture
POSTGRES_PASSWORD=mypasture
POSTGRES_PORT=5432
BACKEND_PORT=8080
NGINX_PORT=80

REDIS_HOST=localhost
REDIS_PORT=6379
KOR1910_HTML_PATH=data/kor_html
BIBLE_IMPORT_ENABLED=true

OPENAI_API_KEY=test
OPENAI_MODEL=gpt-5.6-terra
OPENAI_GENERATOR_MODEL=gpt-5.6-terra
OPENAI_EVALUATOR_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_EVALUATOR_REASONING_EFFORT=medium
AI_EVALUATION_ENABLED=true
AI_EVALUATION_THRESHOLD=4
AI_EVALUATION_MAX_OUTPUT_TOKENS=250
AI_MAX_REVISION_COUNT=1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_BATCH_SIZE=100
AI_EMBEDDING_INDEXING_ENABLED=false
AI_EMBEDDING_INDEX_POLL_DELAY_MS=10000
AI_EMBEDDING_INPUT_COST_PER_MILLION=0.02
AI_MOCK_ENABLED=true
# Live smoke test only. This does not change the model used by the application.
OPENAI_SMOKE_TEST_MODEL=gpt-4.1-nano
OPENAI_SMOKE_MAX_OUTPUT_TOKENS=16
AI_MAX_INPUT_CHARS=300
AI_MAX_OUTPUT_TOKENS=700
AI_FREE_DAILY_LIMIT=10
AI_PREMIUM_DAILY_SAFETY_LIMIT=500
AI_PRIVACY_HASH_SECRET=local-ai-privacy-secret-change-me
COUPON_CODE_PEPPER=local-coupon-code-pepper-change-me
COUPON_REDEEM_RATE_LIMIT_PER_WINDOW=8
AI_TIMEOUT_MS=12000
AI_STREAM_TIMEOUT_MS=60000
AI_STREAM_CORE_POOL_SIZE=4
AI_STREAM_MAX_POOL_SIZE=16
AI_STREAM_QUEUE_CAPACITY=100
AI_IDEMPOTENCY_RESPONSE_TTL_SECONDS=86400
AI_IDEMPOTENCY_RECEIPT_RETENTION_DAYS=30
AI_IDEMPOTENCY_PENDING_TIMEOUT_MS=120000
AI_CACHE_TTL_SECONDS=86400
AI_RAG_TOP_K=10
AI_RAG_MIN_SIMILARITY=0.35
AI_RAG_LEXICAL_FALLBACK_ENABLED=true
DAILY_WORD_ROTATION_ENABLED=true
DAILY_WORD_GENERATION_ENABLED=false
DAILY_WORD_PROVIDER=local
DAILY_WORD_GENERATION_CRON=0 0 18 * * *
DAILY_WORD_GENERATION_ZONE=Asia/Seoul
DAILY_WORD_TARGET_DAYS_AHEAD=1
DAILY_WORD_LEASE_DURATION=2m
DAILY_WORD_MAX_ATTEMPTS=3
DAILY_WORD_PROMPT_VERSION=daily-word-v1
DAILY_WORD_MAX_OUTPUT_TOKENS=500

JWT_ISSUER=mypasture-local
JWT_SECRET=local-jwt-secret-change-me-32-bytes-minimum
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
RATE_LIMIT_ENABLED=false
QUIET_TIME_JOIN_CODE_RATE_LIMIT_PER_WINDOW=12

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_LEASE_DURATION=2m
NOTIFICATION_INITIAL_BACKOFF=30s
NOTIFICATION_MAX_BACKOFF=1h
NOTIFICATION_SETTINGS_PAGE_SIZE=500
NOTIFICATION_DISPATCH_BATCH_SIZE=100
NOTIFICATION_MAX_BATCHES_PER_RUN=20

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_URL=mypasture://password-reset
PASSWORD_RESET_DELIVERY=log
PASSWORD_RESET_FROM=no-reply@mypasture.app

EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_SIGNUP_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_REQUEST_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_DELIVERY=log
EMAIL_VERIFICATION_FROM=no-reply@mypasture.app
EMAIL_VERIFICATION_HMAC_SECRET=replace-with-at-least-32-random-characters

QUIET_TIME_DEFAULT_MEETING_DURATION_MINUTES=120
QUIET_TIME_QR_EXPIRY_GRACE_MINUTES=30
QUIET_TIME_INVITE_BASE_URL=https://mypasture.app/q/qt
QUIET_TIME_REALTIME_REDIS_ENABLED=false
QUIET_TIME_SSE_TIMEOUT_MS=1800000
QUIET_TIME_SSE_HEARTBEAT_DELAY_MS=15000

# Comma-separated public OAuth client identifiers. Never put client secrets here.
GOOGLE_OAUTH_WEB_CLIENT_IDS=
GOOGLE_OAUTH_IOS_CLIENT_IDS=
GOOGLE_OAUTH_ANDROID_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
KAKAO_TOKEN_INFO_URI=https://kapi.kakao.com/v1/user/access_token_info
KAKAO_APP_IDS=
KAKAO_WEB_REST_API_KEY=
KAKAO_WEB_CLIENT_SECRET=
KAKAO_WEB_REDIRECT_URI=

# Administrator email OTP. Enable only after configuring SMTP and an independent secret.
ADMIN_EMAIL_LOGIN_ENABLED=false
ADMIN_EMAIL_LOGIN_HMAC_SECRET=
ADMIN_EMAIL_LOGIN_FROM=support@mypasture.app
