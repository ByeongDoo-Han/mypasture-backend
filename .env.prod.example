# My Pasture server production environment
# Store actual values in GCP Secret Manager. Do not commit a real .env.prod file.
SPRING_PROFILES_ACTIVE=prod

# docker-compose.prod.yml에서 사용하는 자체 호스팅 PostgreSQL 값
POSTGRES_DB=mypasture
POSTGRES_USER=<prod-db-user>
POSTGRES_PASSWORD=<prod-db-password>
NGINX_PORT=8080

DATABASE_URL=jdbc:postgresql://<prod-postgres-host>:5432/mypasture
DATABASE_USERNAME=<prod-db-user>
DATABASE_PASSWORD=<prod-db-password>
REDIS_HOST=<prod-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<prod-redis-password>
REDIS_SSL_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=https://admin.mypasture.app,https://mypasture.app
KOR1910_HTML_PATH=/app/data/kor_html
# 배포 작업 한 인스턴스에서만 true로 실행한 뒤 다시 false로 설정합니다.
BIBLE_IMPORT_ENABLED=false

OPENAI_API_KEY=<prod-openai-api-key>
OPENAI_MODEL=gpt-5.6-terra
OPENAI_GENERATOR_MODEL=gpt-5.6-terra
OPENAI_EVALUATOR_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_EVALUATOR_REASONING_EFFORT=medium
AI_EVALUATION_ENABLED=true
AI_EVALUATION_THRESHOLD=4
AI_EVALUATION_MAX_OUTPUT_TOKENS=250
AI_MAX_REVISION_COUNT=1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_BATCH_SIZE=100
# 백필 작업을 실행하는 서버 한 대에서만 true로 설정합니다.
AI_EMBEDDING_INDEXING_ENABLED=false
AI_EMBEDDING_INDEX_POLL_DELAY_MS=10000
AI_EMBEDDING_INPUT_COST_PER_MILLION=0.02
AI_MOCK_ENABLED=false
AI_MAX_INPUT_CHARS=300
AI_MAX_OUTPUT_TOKENS=700
AI_FREE_DAILY_LIMIT=10
AI_PREMIUM_DAILY_SAFETY_LIMIT=500
AI_PRIVACY_HASH_SECRET=<at-least-32-byte-random-ai-privacy-secret>
AI_TIMEOUT_MS=12000
AI_STREAM_TIMEOUT_MS=60000
AI_STREAM_CORE_POOL_SIZE=8
AI_STREAM_MAX_POOL_SIZE=64
AI_STREAM_QUEUE_CAPACITY=200
AI_CACHE_TTL_SECONDS=86400
AI_RAG_TOP_K=10
AI_RAG_MIN_SIMILARITY=0.35
# 운영 AI는 vector index가 없을 때 임의의 lexical 답변으로 대체하지 않습니다.
AI_RAG_LEXICAL_FALLBACK_ENABLED=false
DAILY_WORD_GENERATION_ENABLED=true
DAILY_WORD_PROVIDER=openai
DAILY_WORD_GENERATION_CRON=0 0 18 * * *
DAILY_WORD_GENERATION_ZONE=Asia/Seoul
DAILY_WORD_TARGET_DAYS_AHEAD=1
DAILY_WORD_LEASE_DURATION=2m
DAILY_WORD_MAX_ATTEMPTS=3
DAILY_WORD_PROMPT_VERSION=daily-word-v1
DAILY_WORD_MAX_OUTPUT_TOKENS=500

JWT_ISSUER=mypasture
JWT_SECRET=<at-least-32-byte-random-secret>
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-user>
SMTP_PASSWORD=<smtp-password>
PASSWORD_RESET_URL=https://mypasture.app/password-reset
PASSWORD_RESET_DELIVERY=smtp
PASSWORD_RESET_FROM=no-reply@mypasture.app

FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CREDENTIALS_PATH=<mounted-credentials-path>
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_LEASE_DURATION=2m
NOTIFICATION_INITIAL_BACKOFF=30s
NOTIFICATION_MAX_BACKOFF=1h
NOTIFICATION_SETTINGS_PAGE_SIZE=500
NOTIFICATION_DISPATCH_BATCH_SIZE=100
NOTIFICATION_MAX_BATCHES_PER_RUN=20

QUIET_TIME_DEFAULT_MEETING_DURATION_MINUTES=120
QUIET_TIME_QR_EXPIRY_GRACE_MINUTES=30
QUIET_TIME_INVITE_BASE_URL=https://mypasture.app/q/qt

GOOGLE_OAUTH_WEB_CLIENT_IDS=<google-web-client-id>
GOOGLE_OAUTH_IOS_CLIENT_IDS=<google-ios-client-id>
GOOGLE_OAUTH_ANDROID_CLIENT_IDS=<google-android-client-id>
APPLE_OAUTH_CLIENT_IDS=com.mypasture.app
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
KAKAO_TOKEN_INFO_URI=https://kapi.kakao.com/v1/user/access_token_info
KAKAO_APP_IDS=<kakao-numeric-app-id>
