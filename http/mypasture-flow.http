### 10. Complete faith profile assessment
POST {{baseUrl}}/api/v1/faith-profile/assessments/{{assessmentId}}/complete
Authorization: Bearer {{accessToken}}

> {%
client.test("Faith profile result is WMCG", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.typeCode === "WMCG", "Expected WMCG");
  client.assert(response.body.dimensionScores.length === 4, "Expected 4 dimension scores");
});
client.global.set("faithResultId", response.body.id);
%}

### 11. Get faith profile result
GET {{baseUrl}}/api/v1/faith-profile/results/{{faithResultId}}
Authorization: Bearer {{accessToken}}

> {%
client.test("Faith profile result can be loaded", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.id === client.global.get("faithResultId"), "Expected same result id");
});
%}

### 12. Recommend quiet time passages
GET {{baseUrl}}/api/v1/quiet-time/passages/recommendations?theme=불안&beginnerOnly=true&size=3
Authorization: Bearer {{accessToken}}

> {%
client.test("Quiet time recommendations are returned", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.length > 0, "Expected recommendations");
  client.assert(!!response.body[0].id, "Expected passage id");
});
client.global.set("passageId", response.body[0].id);
%}

### 13. Create quiet time pasture
POST {{baseUrl}}/api/v1/quiet-time/pastures
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "플로우 큐티 목장",
  "leaderName": "Flow Leader"
}

> {%
client.test("Quiet time pasture is created", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(!!response.body.id, "Expected pasture id");
  client.assert(!!response.body.inviteCode, "Expected invite code");
});
client.global.set("pastureId", response.body.id);
%}

### 14. Create offline quiet time session with invite URL
POST {{baseUrl}}/api/v1/quiet-time/pastures/{{pastureId}}/sessions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "토요 오프라인 큐티",
  "passageId": "{{passageId}}",
  "theme": "불안"
}

> {%
client.test("Offline quiet time session has frontend invite URL", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(!!response.body.offlineCode, "Expected offline code");
  client.assert(response.body.inviteUrl.includes(response.body.offlineCode), "Invite URL should contain offline code");
  client.assert(response.body.qrStatus === "OPEN", "Expected open QR");
  client.assert(!!response.body.expiresAt, "Expected QR expiry");
});
client.global.set("quietTimeSessionId", response.body.id);
client.global.set("offlineCode", response.body.offlineCode);
%}

### 15. Simulate QR scan and load offline session
GET {{baseUrl}}/api/v1/quiet-time/offline/{{offlineCode}}

> {%
client.test("QR invite URL resolves offline session", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.offlineCode === client.global.get("offlineCode"), "Expected same offline code");
  client.assert(!!response.body.inviteUrl, "Expected frontend invite URL");
  client.assert(!!response.body.passage.reference, "Expected passage reference");
});
%}

### 16. Join quiet time session from scanned QR
POST {{baseUrl}}/api/v1/quiet-time/offline/{{offlineCode}}/join
Content-Type: application/json

{
  "displayName": "{{displayName}}",
  "deviceId": "{{deviceId}}"
}

> {%
client.test("Scanned QR joins quiet time session", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.session.offlineCode === client.global.get("offlineCode"), "Expected same offline code");
  client.assert(response.body.participantCount >= 1, "Expected participant count");
});
%}

### 17. Reissue QR invite URL
POST {{baseUrl}}/api/v1/quiet-time/sessions/{{quietTimeSessionId}}/qr/reissue
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

> {%
client.test("Reissue returns a new invite URL", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.offlineCode !== client.global.get("offlineCode"), "Expected a new offline code");
  client.assert(response.body.inviteUrl.includes(response.body.offlineCode), "Expected new invite URL");
});
client.global.set("oldOfflineCode", client.global.get("offlineCode"));
client.global.set("offlineCode", response.body.offlineCode);
%}

### 18. Old invite URL is revoked after reissue
GET {{baseUrl}}/api/v1/quiet-time/offline/{{oldOfflineCode}}

> {%
client.test("Old QR is queryable as revoked", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.qrStatus === "REVOKED", "Expected revoked old QR");
});
%}

### 19. Revoke current QR immediately
DELETE {{baseUrl}}/api/v1/quiet-time/sessions/{{quietTimeSessionId}}/qr
Authorization: Bearer {{accessToken}}

> {%
client.test("Leader can revoke current QR", function () {
  client.assert(response.status === 204, "Expected HTTP 204");
});
%}

### 20. Revoked QR cannot be used to join
POST {{baseUrl}}/api/v1/quiet-time/offline/{{offlineCode}}/join
Content-Type: application/json

{
  "displayName": "{{displayName}}",
  "deviceId": "revoked-{{deviceId}}"
}

> {%
client.test("Revoked QR is rejected", function () {
  client.assert(response.status === 410, "Expected HTTP 410");
  client.assert(response.body.code === "QUIET_TIME_QR_REVOKED", "Expected revoked QR error");
});
%}

### 21. Negative case: invalid quiet time recommendation size
GET {{baseUrl}}/api/v1/quiet-time/passages/recommendations?size=100

> {%
client.test("Invalid size is rejected", function () {
  client.assert(response.status === 400, "Expected HTTP 400");
  client.assert(response.body.code === "INVALID_QUIET_TIME_REQUEST", "Expected INVALID_QUIET_TIME_REQUEST");
});
%}
