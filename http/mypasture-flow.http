### 00. Health check
GET {{baseUrl}}/actuator/health

> {%
client.test("Backend is healthy", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
});
%}

### 01. Sign up
POST {{baseUrl}}/api/v1/auth/signup
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "displayName": "Flow Tester"
}

> {%
client.test("Signup creates a user", function () {
  client.assert(response.status === 201, "Expected HTTP 201");
  client.assert(!!response.body.user.id, "Expected user id");
});
client.global.set("userId", response.body.user.id);
%}

### 02. Login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
client.test("Login returns token", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(!!response.body.token, "Expected token");
});
client.global.set("accessToken", response.body.token);
%}

### 03. Bible versions
GET {{baseUrl}}/api/v1/bibles/versions
Authorization: Bearer {{accessToken}}

> {%
client.test("KOR1910 version is available", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body[0].code === "KOR1910", "Expected KOR1910");
});
%}

### 04. Bible books
GET {{baseUrl}}/api/v1/bibles/KOR1910/books
Authorization: Bearer {{accessToken}}

> {%
client.test("Bible book list is returned", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.length === 66, "Expected 66 books");
});
%}

### 05. Read a full chapter
GET {{baseUrl}}/api/v1/bibles/KOR1910/books/GEN/chapters/1
Authorization: Bearer {{accessToken}}

> {%
client.test("Genesis chapter 1 is returned", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.book.code === "GEN", "Expected GEN");
  client.assert(response.body.verses.length > 0, "Expected verses");
});
%}

### 06. Search bible verses by keyword
GET {{baseUrl}}/api/v1/bibles/KOR1910/search?keyword=하나님&page=0&size=5
Authorization: Bearer {{accessToken}}

> {%
client.test("Bible search returns matching verses", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.keyword === "하나님", "Expected keyword");
  client.assert(response.body.results.length > 0, "Expected search results");
});
%}

### 06-1. Ask AI pastor with server-side RAG
POST {{baseUrl}}/api/v1/ai/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "question": "창세기 말씀을 설명해주세요"
}

> {%
client.test("AI answer contains verified Bible citations", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.citations.length > 0, "Expected grounded citations");
  client.assert(!!response.body.retrievalStrategy, "Expected retrieval strategy");
  client.assert(response.body.questionIntent === "BIBLE_EXPLANATION", "Expected explanation intent");
});
%}

### 06-1-1. Ask an explicitly referenced Bible verse
POST {{baseUrl}}/api/v1/ai/chat
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "question": "창세기 1장 1절을 설명해주세요"
}

> {%
client.test("Explicit reference returns the exact database verse", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.retrievalStrategy === "DIRECT_REFERENCE", "Expected direct reference strategy");
  client.assert(response.body.citations.length === 1, "Expected one exact citation");
  client.assert(response.body.citations[0].book === "창세기", "Expected Genesis");
  client.assert(response.body.citations[0].chapter === 1, "Expected chapter 1");
  client.assert(response.body.citations[0].verse === 1, "Expected verse 1");
});
%}

### 06-2. Stream AI pastor answer with server-side RAG
POST {{baseUrl}}/api/v1/ai/chat/stream
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: text/event-stream

{
  "question": "불안할 때 붙들 말씀을 알려주세요"
}

> {%
client.test("AI stream completes with citations and usage", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.indexOf("event:status") >= 0, "Expected question processing status event");
  client.assert(response.body.indexOf("UNDERSTANDING_QUESTION") >= 0, "Expected question understanding stage");
  client.assert(response.body.indexOf("event:delta") >= 0, "Expected delta event");
  client.assert(response.body.indexOf("event:citations") >= 0, "Expected citations event");
  client.assert(response.body.indexOf("event:usage") >= 0, "Expected usage event");
  client.assert(response.body.indexOf("event:done") >= 0, "Expected done event");
});
%}

### 07. Get current faith profile test
GET {{baseUrl}}/api/v1/faith-profile/tests/current
Authorization: Bearer {{accessToken}}

> {%
client.test("Faith profile test definition is returned", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.code === "FAITH_RHYTHM", "Expected FAITH_RHYTHM");
  client.assert(response.body.questions.length === 8, "Expected 8 questions");
});
client.global.set("q1", response.body.questions[0].id);
client.global.set("q2", response.body.questions[1].id);
client.global.set("q3", response.body.questions[2].id);
client.global.set("q4", response.body.questions[3].id);
client.global.set("q5", response.body.questions[4].id);
client.global.set("q6", response.body.questions[5].id);
client.global.set("q7", response.body.questions[6].id);
client.global.set("q8", response.body.questions[7].id);
%}

