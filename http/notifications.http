### 인증 사용자의 첫 알림 페이지
GET {{baseUrl}}/api/v1/notifications?limit=20
Authorization: Bearer {{accessToken}}

> {%
  client.test("알림 목록을 조회한다", function () {
    client.assert(response.status === 200, "응답 상태가 200이어야 합니다.");
    client.assert(Array.isArray(response.body.items), "items가 배열이어야 합니다.");
  });
  if (response.body.items.length > 0) {
    client.global.set("notificationId", response.body.items[0].id);
  }
%}

### 미읽음 개수
GET {{baseUrl}}/api/v1/notifications/unread-count
Authorization: Bearer {{accessToken}}

### 첫 알림 읽음 처리
POST {{baseUrl}}/api/v1/notifications/{{notificationId}}/read
Authorization: Bearer {{accessToken}}

### 전체 읽음 처리
POST {{baseUrl}}/api/v1/notifications/read-all
Authorization: Bearer {{accessToken}}

### 앱 수신 확인 (실제 deliveryId와 설치 deviceId 사용)
POST {{baseUrl}}/api/v1/notifications/deliveries/{{notificationDeliveryId}}/ack
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "deviceId": "{{notificationDeviceId}}",
  "event": "RECEIVED_BY_APP"
}

### 푸시 열기 확인 (중복 호출해도 최초 시각 유지)
POST {{baseUrl}}/api/v1/notifications/deliveries/{{notificationDeliveryId}}/ack
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "deviceId": "{{notificationDeviceId}}",
  "event": "OPENED"
}

### 관리자 알림 운영 현황
GET {{baseUrl}}/api/v1/admin/notifications/operations?from=2026-08-01T00:00:00Z&to=2026-08-31T00:00:00Z&page=0&size=20
Authorization: Bearer {{adminAccessToken}}
