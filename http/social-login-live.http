### Google nonce challenge 발급
# 먼저 실행한 뒤 응답 nonce를 Google 인증 요청에 포함해 ID Token을 새로 발급받아야 합니다.
POST {{baseUrl}}/api/v1/auth/social-login/challenges

> {%
client.global.set("googleChallengeId", response.body.challengeId);
client.global.set("googleNonce", response.body.nonce);
%}

### Google 실제 로그인
# @name googleSocialLogin
POST {{baseUrl}}/api/v1/auth/social-login
Content-Type: application/json

{
  "provider": "GOOGLE",
  "idToken": "{{googleIdToken}}",
  "challengeId": "{{googleChallengeId}}"
}

> {%
client.test("Google social login returns JWT", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.tokenType === "Bearer", "Expected Bearer token");
  client.assert(!!response.body.token, "Expected access token");
  client.assert(!!response.body.refreshToken, "Expected refresh token");
  client.assert(!!response.body.user.id, "Expected user id");
});
client.global.set("googleAccessToken", response.body.token);
%}

### Google 로그인 사용자 조회
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{googleAccessToken}}

> {%
client.test("Google JWT resolves current user", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(!!response.body.id, "Expected user id");
});
%}

### Apple nonce challenge 발급
# 먼저 실행한 뒤 응답 nonce를 Apple 인증 요청에 포함해 Identity Token을 새로 발급받아야 합니다.
POST {{baseUrl}}/api/v1/auth/social-login/challenges

> {%
client.global.set("appleChallengeId", response.body.challengeId);
client.global.set("appleNonce", response.body.nonce);
%}

### Apple 실제 로그인
# @name appleSocialLogin
POST {{baseUrl}}/api/v1/auth/social-login
Content-Type: application/json

{
  "provider": "APPLE",
  "idToken": "{{appleIdToken}}",
  "displayName": "{{appleDisplayName}}",
  "challengeId": "{{appleChallengeId}}"
}

> {%
client.test("Apple social login returns JWT", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.tokenType === "Bearer", "Expected Bearer token");
  client.assert(!!response.body.token, "Expected access token");
  client.assert(!!response.body.refreshToken, "Expected refresh token");
});
client.global.set("appleAccessToken", response.body.token);
%}

### Apple 로그인 사용자 조회
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{appleAccessToken}}

> {%
client.test("Apple JWT resolves current user", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(!!response.body.id, "Expected user id");
});
%}

### Kakao 실제 로그인
# @name kakaoSocialLogin
POST {{baseUrl}}/api/v1/auth/social-login
Content-Type: application/json

{
  "provider": "KAKAO",
  "accessToken": "{{kakaoAccessToken}}",
  "displayName": "{{kakaoDisplayName}}"
}

> {%
client.test("Kakao social login returns JWT", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.tokenType === "Bearer", "Expected Bearer token");
  client.assert(!!response.body.token, "Expected access token");
});
client.global.set("kakaoJwt", response.body.token);
%}

### Kakao 로그인 사용자 조회
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{kakaoJwt}}

> {%
client.test("Kakao JWT resolves current user", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(!!response.body.id, "Expected user id");
});
%}

### Kakao 웹 인가 코드 서버 교환
# 브라우저 AuthSession의 단일 사용 code 및 해당 요청의 PKCE verifier를 입력합니다. 값은 로그·공유 문서에 남기지 마세요.
# @name kakaoWebSocialLogin
POST {{baseUrl}}/api/v1/auth/social-login/kakao/web
Content-Type: application/json

{
  "code": "{{kakaoWebAuthorizationCode}}",
  "codeVerifier": "{{kakaoWebCodeVerifier}}"
}

> {%
client.test("Kakao web code exchange returns My Pasture JWT", function () {
  client.assert(response.status === 200, "Expected HTTP 200");
  client.assert(response.body.tokenType === "Bearer", "Expected Bearer token");
  client.assert(!!response.body.token, "Expected access token");
  client.assert(!response.body.accessToken, "Kakao access token must not be returned");
});
%}
